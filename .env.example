# Copy to a shell or a GitHub Actions secret. This file has no real secrets.
# The CLI never posts comments. Do not put a live key on the command line.

# Required for a live model call. Leave empty for the keyless dry-run.
PR_SUMMARY_API_KEY=

# OpenAI-compatible origin, including the /v1 prefix when the provider uses it.
PR_SUMMARY_BASE_URL=https://api.openai.com/v1

PR_SUMMARY_MODEL=gpt-4o-mini
PR_SUMMARY_LANGUAGE=en
PR_SUMMARY_MODE=full
PR_SUMMARY_MAX_DIFF_CHARS=60000
PR_SUMMARY_IGNORE_PATHS=**/node_modules/**,**/dist/**,**/*.lock,**/package-lock.json,**/pnpm-lock.yaml,**/yarn.lock

# Action default is false (do not fail the job). The CLI defaults to true.
PR_SUMMARY_FAIL_ON_ERROR=false

# Tuning. See README environment table.
PR_SUMMARY_MAX_RETRIES=3
PR_SUMMARY_RETRY_BASE_MS=400
PR_SUMMARY_MIN_INTERVAL_MS=250
PR_SUMMARY_TIMEOUT_MS=60000
PR_SUMMARY_CHUNK_CHARS=12000
PR_SUMMARY_MAX_CHUNKS=6
PR_SUMMARY_MAX_OUTPUT_TOKENS=1800
PR_SUMMARY_TEMPERATURE=0.2
PR_SUMMARY_JSON_MODE=true
PR_SUMMARY_MAX_FILES=300
PR_SUMMARY_MAX_COMMITS=50
PR_SUMMARY_MAX_BODY_CHARS=4000
PR_SUMMARY_MAX_COMMENT_CHARS=60000

# Used by the action to read the pull request and, unless dry-run, to upsert one comment.
# Not sent to the model.
GITHUB_TOKEN=
